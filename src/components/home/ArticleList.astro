---
// The home list: flat, in the given order (sorting is the caller's), under a
// `YEAR ────` rule per year. Each row: date · title · reading time. Renders
// nothing for no entries, so the caller shows EmptyState.
import { isoDate } from '@/lib/date';

export interface Entry {
	title: string;
	href: string;
	date: Date;
	/** Not shown in the list; kept for S-05's data. */
	summary?: string;
	readingMinutes?: number;
}

interface Props {
	entries: Entry[];
}
const { entries } = Astro.props;
const years = [...new Set(entries.map((e) => e.date.getUTCFullYear()))];
---

{
	entries.length > 0 && (
		<section class="mt-10" aria-label="Articles">
			{years.map((year) => (
				<div class="mt-9 first:mt-0">
					<h2 class="rule">{year}</h2>
					<ol class="mt-2">
						{entries
							.filter((e) => e.date.getUTCFullYear() === year)
							.map((e) => (
								<li>
									<a
										href={e.href}
										class="group press grid grid-cols-[1fr_auto] items-baseline gap-x-4 gap-y-1 py-2.5 sm:grid-cols-[auto_1fr_auto]">
										<time datetime={isoDate(e.date)} class="text-fine text-muted-foreground tabular-nums">
											{isoDate(e.date)}
										</time>
										<span class="col-span-2 row-start-2 leading-[1.4] transition-colors duration-100 group-hover:text-primary sm:col-span-1 sm:row-start-auto">
											{e.title}
										</span>
										{e.readingMinutes !== undefined && (
											<span class="col-start-2 row-start-1 justify-self-end text-fine text-muted-foreground tabular-nums sm:col-start-auto sm:row-start-auto">
												{e.readingMinutes} min
											</span>
										)}
									</a>
								</li>
							))}
					</ol>
				</div>
			))}
		</section>
	)
}
