---
import { repo } from '@/config/links';

const year = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-3xl px-5 pb-10">
	<div class="rule" role="presentation">eof</div>
	<p class="mt-3 text-fine text-muted-foreground">
		© {year} Janusz Majek <span aria-hidden="true">·</span>{' '}
		<a href={repo.href} class="press transition-colors duration-100 hover:text-primary focus-visible:text-primary"
			>source <span aria-hidden="true">↗</span></a
		>
	</p>
</footer>
