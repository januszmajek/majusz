---
import { nav } from '@/config/nav';

interface Props {
	/** `id` of the nav item for the current page. */
	current?: string;
}
const { current } = Astro.props;
---

<header class="mx-auto flex w-full max-w-3xl items-center justify-between gap-6 px-5 pt-8 sm:pt-10">
	<a href="/" class="press text-wordmark">majusz</a>
	<nav aria-label="Main">
		<ul class="flex items-center gap-4 text-nav sm:gap-6">
			{
				nav.map((item) => (
					<li>
						<a
							href={item.href}
							aria-current={current === item.id ? 'page' : undefined}
							class:list={['press', current === item.id ? 'font-medium text-foreground' : 'quiet text-muted-foreground']}>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
