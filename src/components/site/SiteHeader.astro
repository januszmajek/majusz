---
import ThemeToggle from '@/components/site/ThemeToggle.astro';
import { nav } from '@/config/nav';

interface Props {
	/** `id` of the nav item for the current page. */
	current?: string;
}
const { current } = Astro.props;
// The file build renders `/about` as `/about.html` (home as `/index.html`), dev as `/about`:
// drop the extension, then any trailing slash, before comparing with the nav `href`.
const path = (Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/').replace(/(.)\/$/, '$1');
---

<header class="mx-auto flex w-full max-w-3xl items-center justify-between gap-6 px-5 pt-8 sm:pt-10">
	<a href="/" class="press text-wordmark transition-colors duration-100 hover:text-primary">Janusz Majek</a>
	<div class="flex items-center gap-4 sm:gap-6">
		{
			nav.length > 0 && (
				<nav aria-label="Main">
					<ul class="flex items-center gap-4 text-nav sm:gap-6">
						{
							nav.map((item) => (
								<li>
									<a
										href={item.href}
										aria-current={current === item.id ? (path === item.href ? 'page' : 'true') : undefined}
										class:list={['press', current === item.id ? 'font-medium text-foreground' : 'quiet text-muted-foreground']}>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			)
		}
		<ThemeToggle />
	</div>
</header>
