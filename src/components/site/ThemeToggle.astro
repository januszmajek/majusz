---
// Header sun/moon switch (design.md, Theme toggle). The shadcn Button renders
// as static HTML (no client:* directive, so no React ships). The icon shows the
// current theme, swapped by `dark:` classes so it is right before any script.
// ThemeScript applies the stored choice before paint; this only flips and stores.
import { Moon, Sun } from 'lucide-react';
import { Button } from '@/components/ui/button';
---

<Button
	type="button"
	variant="ghost"
	size="icon-lg"
	aria-label="Dark theme"
	aria-pressed="false"
	data-theme-toggle
	className="relative -mr-2 focus-visible:border-transparent focus-visible:ring-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-solid focus-visible:outline-primary">
	<Sun
		aria-hidden="true"
		className="size-5 scale-100 rotate-0 transition-transform motion-reduce:transition-none dark:scale-0 dark:-rotate-90"
	/>
	<Moon
		aria-hidden="true"
		className="absolute size-5 scale-0 rotate-90 transition-transform motion-reduce:transition-none dark:scale-100 dark:rotate-0"
	/>
</Button>

<script>
	const html = document.documentElement;
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
	// `.dark` also changes from other tabs and the device; mirror every change.
	const sync = () => {
		const dark = String(html.classList.contains('dark'));
		buttons.forEach((button) => button.setAttribute('aria-pressed', dark));
	};
	sync();
	new MutationObserver(sync).observe(html, { attributes: true, attributeFilter: ['class'] });

	buttons.forEach((button) =>
		button.addEventListener('click', () => {
			const dark = html.classList.toggle('dark');
			// Blocked storage still switches this page, just not the next one.
			try {
				localStorage.setItem('theme', dark ? 'dark' : 'light');
			} catch {}
		}),
	);
</script>
