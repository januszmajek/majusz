---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Motif from '@/components/site/Motif.astro';
import SiteFooter from '@/components/site/SiteFooter.astro';
import SiteHeader from '@/components/site/SiteHeader.astro';
import ThemeScript from '@/components/site/ThemeScript.astro';

interface Props {
	title?: string;
	description?: string;
	/** `id` of the nav item marked as the current page. */
	current?: string;
}

const { title = 'majusz.com', description, current } = Astro.props;

// Chromium prerenders a same-origin page as the reader heads for its link (`moderate`: hover on
// desktop, viewport heuristics on mobile), so the click is instant. Zero JS; other browsers
// ignore it. No `prefetch` rule: Astro's prefetch (astro.config.mjs) covers fetching.
const speculationRules = {
	prerender: [
		{
			where: {
				and: [
					{ href_matches: '/*' },
					{ not: { href_matches: '/_astro/*' } },
					{ not: { href_matches: '/fonts/*' } },
					{ not: { selector_matches: '[rel~=nofollow],[data-no-prerender]' } },
				],
			},
			eagerness: 'moderate',
		},
	],
};

// Latin Modern Math for formulas. Not in public/: src/integrations/math-font.ts serves the full
// font at this URL in dev and, after the build, writes a subset of the glyphs the pages use and
// adds a content-hash `?v=` to the URL in every built page. Inline here, not in prose.css:
// /_astro/*.css is hashed before that rewrite and cached immutable for a year, so a URL changed
// inside it would keep returning readers on the old subset; HTML turns over within 60 s.
const mathFontFace = '@font-face{font-family:"Latin Modern Math";src:url("/fonts/latin-modern-math.woff2") format("woff2");font-display:swap}';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<meta name="color-scheme" content="light dark" />
		<ThemeScript />
		<!-- Preload the three faces every first screen uses: Iosevka 400 (meta, list, nav),
		     Iosevka 600 (wordmark, titles) and Aile 400 (reading text). Other faces load on use,
		     ~25 KB each. -->
		<Font cssVariable="--font-iosevka" preload={[{ weight: '400', style: 'normal' }, { weight: '600', style: 'normal' }]} />
		<Font cssVariable="--font-iosevka-aile" preload={[{ weight: '400', style: 'normal' }]} />
		<style is:inline set:html={mathFontFace} />
		<script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)} />
	</head>
	<body class="relative flex min-h-svh flex-col">
		<Motif />
		<SiteHeader current={current} />
		<main class="mx-auto w-full max-w-3xl flex-1 px-5 pt-12 pb-16 sm:pt-16">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
