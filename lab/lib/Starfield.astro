---
// A slowly drifting night sky on a canvas, shared by lab variants. Star color
// comes from the `--star` custom property, so each variant and theme sets its own.
// Rules (directions.md): starts after the page loads, pauses when hidden or
// off-screen, never moves under reduced motion, no twinkle.
interface Props {
	class?: string;
	/** Stars per 10,000 px². */
	density?: number;
	/** Drift of the nearest stars, in px per second. */
	speed?: number;
	/** Opacity of the brightest star. */
	maxAlpha?: number;
}

const { class: className, density = 1.2, speed = 3, maxAlpha = 0.8 } = Astro.props;
---

<canvas
	class={className}
	aria-hidden="true"
	data-starfield
	data-density={density}
	data-speed={speed}
	data-max-alpha={maxAlpha}></canvas>

<script>
	interface Star {
		x: number;
		y: number;
		r: number;
		alpha: number;
		depth: number;
	}

	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

	function start(canvas: HTMLCanvasElement) {
		const ctx = canvas.getContext('2d');
		if (!ctx) return;
		const density = Number(canvas.dataset.density);
		const speed = Number(canvas.dataset.speed);
		const maxAlpha = Number(canvas.dataset.maxAlpha);

		let stars: Star[] = [];
		let width = 0;
		let height = 0;
		let color = '';
		let visible = true;
		let frame = 0;
		let last = 0;
		let offset = 0;

		const readColor = () => {
			color = getComputedStyle(canvas).getPropertyValue('--star').trim() || '#fff';
		};

		const resize = () => {
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			width = canvas.clientWidth;
			height = canvas.clientHeight;
			canvas.width = Math.round(width * dpr);
			canvas.height = Math.round(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			const count = Math.round(((width * height) / 10000) * density);
			stars = Array.from({ length: count }, () => {
				const depth = 0.25 + Math.random() * 0.75;
				return {
					x: Math.random() * width,
					y: Math.random() * height,
					r: 0.4 + depth * 0.9,
					alpha: maxAlpha * (0.25 + Math.random() * 0.75) * depth,
					depth,
				};
			});
		};

		const draw = () => {
			ctx.clearRect(0, 0, width, height);
			ctx.fillStyle = color;
			for (const s of stars) {
				const x = (((s.x + offset * s.depth) % width) + width) % width;
				ctx.globalAlpha = s.alpha;
				ctx.beginPath();
				ctx.arc(x, s.y, s.r, 0, Math.PI * 2);
				ctx.fill();
			}
			ctx.globalAlpha = 1;
		};

		const tick = (now: number) => {
			if (last) offset += (speed * (now - last)) / 1000;
			last = now;
			draw();
			frame = requestAnimationFrame(tick);
		};

		const update = () => {
			cancelAnimationFrame(frame);
			last = 0;
			if (visible && !document.hidden && !reducedMotion.matches) {
				frame = requestAnimationFrame(tick);
			} else {
				draw();
			}
		};

		readColor();
		resize();
		update();

		new ResizeObserver(() => {
			resize();
			draw();
		}).observe(canvas);
		new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			update();
		}).observe(canvas);
		// The lab harness and the theme switch toggle `.dark` on <html>.
		new MutationObserver(() => {
			readColor();
			draw();
		}).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
		document.addEventListener('visibilitychange', update);
		reducedMotion.addEventListener('change', update);
	}

	// Content first: the sky starts once the page has loaded and the browser is idle.
	const boot = () =>
		document.querySelectorAll<HTMLCanvasElement>('canvas[data-starfield]').forEach(start);
	const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(boot) : setTimeout(boot, 200));
	if (document.readyState === 'complete') idle();
	else addEventListener('load', idle, { once: true });
</script>
