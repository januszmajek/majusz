---
// Design lab harness: frames one variant page at a time, full size, with the
// prototype skill's picker (.claude/skills/prototype/PICKER.md) as chrome.
import { homeStates, labPages, variantNames, variantOptions } from '../lib/data';

const variants = variantNames();
const articles = labPages().flatMap((p) => (p.kind === 'article' ? [p.id] : []));
const pages = [
	{ id: 'home', label: 'Home' },
	...articles.map((id, i) => ({
		id,
		label: articles.length > 1 ? `Article ${i + 1}` : 'Article',
	})),
	{ id: 'about', label: 'About' },
];
// Per-variant switches (lab/variants/<name>/options.ts), shown only for that variant.
const options = variants.flatMap((variant) =>
	Object.entries(variantOptions(variant)).map(([key, option]) => ({ variant, key, ...option })),
);
const label = (name: string) =>
	name.replace(/-/g, ' ').replace(/^./, (c) => c.toUpperCase());
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Design lab · majusz.com</title>
	</head>
	<body>
		{
			variants.length === 0 ? (
				<p class="lab-empty">No variants in lab/variants/ yet.</p>
			) : (
				<>
					<iframe id="stage" title="Variant preview" />

					<button class="lab-panel-toggle" type="button" aria-expanded="true">
						Hide
					</button>

					<div class="lab-controls">
						{options.length > 0 && (
							<div class="lab-row">
								{options.map((o) =>
									'range' in o ? (
										<label
											class="proto-picker lab-slider"
											data-group={`${o.variant}:${o.key}`}
											data-variant={o.variant}
											data-param={o.key}
											data-pages={o.pages}
											data-default={o.range.value}>
											<span>{o.label}</span>
											<input
												type="range"
												min={o.range.min}
												max={o.range.max}
												step={o.range.step}
												value={o.range.value}
											/>
											<output>{o.range.value}</output>
										</label>
									) : (
									<nav
										class="proto-picker"
										aria-label={o.label}
										data-group={`${o.variant}:${o.key}`}
										data-variant={o.variant}
										data-param={o.key}
										data-pages={o.pages}>
										<span class="proto-picker-highlight" aria-hidden="true" />
										{o.values.map((value) => (
											<button class="proto-picker-item" data-value={value}>
												{label(value)}
											</button>
										))}
									</nav>
									),
								)}
							</div>
						)}
						<nav class="proto-picker" aria-label="Page" data-group="page">
							<span class="proto-picker-highlight" aria-hidden="true" />
							{pages.map((p) => (
								<button class="proto-picker-item" data-value={p.id}>
									{p.label}
								</button>
							))}
						</nav>
						<div class="lab-row">
							<nav class="proto-picker" aria-label="Home articles" data-group="n">
								<span class="proto-picker-highlight" aria-hidden="true" />
								{homeStates.map((n) => (
									<button class="proto-picker-item" data-value={String(n)}>
										{n}
									</button>
								))}
							</nav>
							<nav class="proto-picker" aria-label="Theme" data-group="theme">
								<span class="proto-picker-highlight" aria-hidden="true" />
								<button class="proto-picker-item" data-value="light">Light</button>
								<button class="proto-picker-item" data-value="dark">Dark</button>
							</nav>
						</div>
					</div>

					<nav class="proto-picker" aria-label="Prototype variants" data-group="v">
						<span class="proto-picker-highlight" aria-hidden="true" />
						{variants.map((name) => (
							<button class="proto-picker-item" data-value={name}>
								{label(name)}
							</button>
						))}
					</nav>
				</>
			)
		}
	</body>
</html>

<script>
	// Built-in groups, plus `<variant>:<param>` groups for variant options.
	type Group = string;

	const stage = document.getElementById('stage') as HTMLIFrameElement | null;
	const pickers = new Map<Group, HTMLElement>();
	document.querySelectorAll<HTMLElement>('.proto-picker').forEach((el) => {
		pickers.set(el.dataset.group as Group, el);
	});

	const values = (group: Group) =>
		[...pickers.get(group)!.querySelectorAll<HTMLElement>('.proto-picker-item')].map(
			(el) => el.dataset.value!,
		);

	// State lives in the URL query so a reload or the phone keeps its place.
	const params = new URLSearchParams(location.search);
	const state: Record<Group, string> = {};
	const defaults: Record<Group, string> = { page: 'home', n: '2', theme: 'light' };
	// The query key of a group: variant options use their bare param name.
	const param = (group: Group) => pickers.get(group)!.dataset.param ?? group;
	if (stage) {
		for (const [group, picker] of pickers) {
			if (picker.dataset.default !== undefined) {
				const wanted = Number(params.get(param(group)));
				state[group] = String(Number.isFinite(wanted) && wanted > 0 ? wanted : picker.dataset.default);
				continue;
			}
			const options = values(group);
			const wanted = params.get(param(group)) ?? defaults[group];
			state[group] = wanted && options.includes(wanted) ? wanted : options[0];
		}
	}

	// Show the bottom row's switches for the current variant and page only.
	function showControls() {
		pickers.get('n')!.hidden = state.page !== 'home';
		for (const picker of pickers.values()) {
			const { variant, pages } = picker.dataset;
			if (!variant) continue;
			picker.hidden =
				variant !== state.v || (pages === 'article' && !state.page.startsWith('article'));
			if (!picker.hidden) moveHighlight(picker.dataset.group!);
		}
	}

	// Write the current variant's options into the query, which the variant reads
	// from its parent on load.
	function syncOptions(url: URL) {
		for (const [group, picker] of pickers) {
			if (picker.dataset.variant === state.v) url.searchParams.set(param(group), state[group]);
		}
	}

	function moveHighlight(group: Group) {
		const picker = pickers.get(group)!;
		const highlight = picker.querySelector<HTMLElement>('.proto-picker-highlight')!;
		const el = picker.querySelector<HTMLElement>('[data-active]');
		if (!el) return;
		highlight.style.width = el.offsetWidth + 'px';
		highlight.style.transform = `translateX(${el.offsetLeft}px)`;
	}

	function render(group: Group) {
		pickers.get(group)!
			.querySelectorAll<HTMLElement>('.proto-picker-item')
			.forEach((el) => {
				const on = el.dataset.value === state[group];
				el.toggleAttribute('data-active', on);
				if (on) el.setAttribute('aria-current', 'true');
				else el.removeAttribute('aria-current');
			});
		moveHighlight(group);
	}

	// Sliders apply live, as data-<param> on the variant's <html>, without a re-mount.
	const sliders = [...pickers].filter(([, picker]) => picker.dataset.default !== undefined);

	function applyTheme() {
		const doc = stage?.contentDocument;
		doc?.documentElement.classList.toggle('dark', state.theme === 'dark');
		for (const [group, picker] of sliders) {
			if (picker.dataset.variant === state.v) doc?.documentElement.setAttribute(`data-${param(group)}`, state[group]);
		}
	}

	function mount() {
		const page = state.page === 'home' ? `home-${state.n}` : state.page;
		// Switching swaps the iframe src, which re-mounts the variant page.
		stage!.src = `/v/${state.v}/${page}`;
	}

	function set(group: Group, value: string) {
		if (!values(group).includes(value)) return;
		state[group] = value;
		render(group);
		showControls();
		const url = new URL(location.href);
		url.searchParams.set(param(group), value);
		syncOptions(url);
		history.replaceState(null, '', url);
		if (group === 'theme') applyTheme();
		else mount();
	}

	if (stage) {
		stage.addEventListener('load', applyTheme);

		for (const [group, picker] of pickers) {
			picker.querySelectorAll<HTMLElement>('.proto-picker-item').forEach((el) => {
				el.addEventListener('click', () => set(group, el.dataset.value!));
			});
			render(group);
		}
		for (const [group, picker] of sliders) {
			const input = picker.querySelector('input')!;
			const output = picker.querySelector('output')!;
			input.value = output.value = state[group];
			input.addEventListener('input', () => {
				state[group] = output.value = input.value;
				const url = new URL(location.href);
				url.searchParams.set(param(group), input.value);
				history.replaceState(null, '', url);
				applyTheme();
			});
		}
		const url = new URL(location.href);
		syncOptions(url);
		history.replaceState(null, '', url);
		showControls();
		mount();

		window.addEventListener('resize', () => pickers.forEach((_, g) => moveHighlight(g)));

		// Number keys and arrows switch variants, as in the prototype skill.
		document.addEventListener('keydown', (e) => {
			const target = e.target as HTMLElement;
			if (/^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName) || target.isContentEditable) return;
			if (e.metaKey || e.ctrlKey || e.altKey) return;
			if (e.key === 'h') return toggle.click();
			const names = values('v');
			const current = names.indexOf(state.v);
			const num = parseInt(e.key, 10);
			if (num >= 1 && num <= names.length) set('v', names[num - 1]);
			else if (e.key === 'ArrowRight') set('v', names[(current + 1) % names.length]);
			else if (e.key === 'ArrowLeft') set('v', names[(current - 1 + names.length) % names.length]);
		});

		// The panel can be collapsed to a single pill; the choice is remembered.
		const toggle = document.querySelector<HTMLButtonElement>('.lab-panel-toggle')!;
		function showPanel(show: boolean) {
			document.body.toggleAttribute('data-panel-hidden', !show);
			toggle.setAttribute('aria-expanded', String(show));
			toggle.textContent = show ? 'Hide' : 'Controls';
			try {
				localStorage.setItem('lab-panel', show ? 'shown' : 'hidden');
			} catch {}
			if (show) pickers.forEach((_, g) => moveHighlight(g));
		}
		toggle.addEventListener('click', () =>
			showPanel(document.body.hasAttribute('data-panel-hidden')),
		);
		let stored: string | null = null;
		try {
			stored = localStorage.getItem('lab-panel');
		} catch {}
		if (stored === 'hidden') showPanel(false);

		// Enable the slide only after first paint, so load doesn't animate.
		requestAnimationFrame(() =>
			requestAnimationFrame(() => pickers.forEach((p) => p.setAttribute('data-ready', ''))),
		);
	}
</script>

<style is:global>
	html,
	body {
		margin: 0;
		height: 100%;
		background: #1a1a1a;
	}

	#stage {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		background: #fff;
	}

	.lab-empty {
		margin: 0;
		padding: 24px;
		color: rgba(255, 255, 255, 0.7);
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
	}

	/* Page, home-state and theme pills stack above the variant picker, which keeps
	   its spec position, so the variant's header stays visible. */
	.lab-controls {
		position: fixed;
		bottom: 68px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 2147483647;
		display: flex;
		flex-direction: column-reverse;
		align-items: center;
		gap: 8px;
	}

	/* Collapsed: only the toggle stays. */
	body[data-panel-hidden] .lab-controls,
	body[data-panel-hidden] .proto-picker[data-group='v'] {
		display: none;
	}

	.lab-panel-toggle {
		position: fixed;
		right: 16px;
		bottom: 24px;
		z-index: 2147483647;
		height: 36px;
		padding: 0 14px;
		border: 0;
		border-radius: 999px;
		background: rgba(10, 10, 10, 0.82);
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.08) inset,
			0 8px 24px rgba(0, 0, 0, 0.24);
		color: rgba(255, 255, 255, 0.75);
		font: 13px/1 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		cursor: pointer;
	}

	.lab-panel-toggle:active {
		transform: scale(0.97);
	}

	.lab-panel-toggle:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.4);
		outline-offset: 2px;
	}

	/* On narrow screens the variant row scrolls sideways and leaves room for the toggle. */
	@media (max-width: 600px) {
		.proto-picker[data-group='v'] {
			left: 8px;
			right: 96px;
			transform: none;
			overflow-x: auto;
			scrollbar-width: none;
		}
	}

	.lab-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
	}

	/* A row whose switches all belong to other variants takes no space. */
	.lab-row:not(:has(> .proto-picker:not([hidden]))) {
		display: none;
	}

	.lab-controls .proto-picker {
		position: relative;
		bottom: auto;
		left: auto;
		transform: none;
	}

	/* Keep labels on one line; long variant names wrapped inside the pill. */
	.proto-picker .proto-picker-item {
		white-space: nowrap;
	}

	.proto-picker[hidden] {
		display: none;
	}

	/* Picker spec, verbatim from .claude/skills/prototype/PICKER.md. */
	.proto-picker {
		position: fixed;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 2147483647;
		display: flex;
		align-items: center;
		gap: 2px;
		padding: 4px;
		border-radius: 999px;
		background: rgba(10, 10, 10, 0.82);
		-webkit-backdrop-filter: blur(12px) saturate(1.4);
		backdrop-filter: blur(12px) saturate(1.4);
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.08) inset,
			0 8px 24px rgba(0, 0, 0, 0.24),
			0 2px 6px rgba(0, 0, 0, 0.12);
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		font-size: 13px;
		line-height: 1;
		-webkit-font-smoothing: antialiased;
		user-select: none;
		-webkit-user-select: none;
	}

	.proto-picker-highlight {
		position: absolute;
		top: 4px;
		left: 0;
		height: 28px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.12);
		will-change: transform;
	}

	/* The slide is enabled only after first paint (data-ready), so load doesn't animate. */
	.proto-picker[data-ready] .proto-picker-highlight {
		transition:
			transform 250ms cubic-bezier(0.23, 1, 0.32, 1),
			width 250ms cubic-bezier(0.23, 1, 0.32, 1);
	}

	@media (prefers-reduced-motion: reduce) {
		.proto-picker[data-ready] .proto-picker-highlight {
			transition: none;
		}
	}

	.proto-picker-item {
		position: relative; /* sits above the highlight */
		display: flex;
		align-items: center;
		height: 28px;
		padding: 0 12px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: rgba(255, 255, 255, 0.55);
		font: inherit;
		cursor: pointer;
		transition: color 150ms ease-out;
	}

	.proto-picker-item:hover {
		color: rgba(255, 255, 255, 0.85);
	}

	.proto-picker-item:active {
		transform: scale(0.97);
	}

	.proto-picker-item:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.4);
		outline-offset: 2px;
	}

	.proto-picker-item[data-active] {
		color: #fff;
	}

	/* A slider in a picker pill: label, track, value. */
	.lab-slider {
		gap: 10px;
		height: 28px;
		padding: 4px 14px;
		color: rgba(255, 255, 255, 0.55);
	}

	.lab-slider input {
		width: 160px;
		margin: 0;
		accent-color: #fff;
	}

	.lab-slider output {
		min-width: 2.6em;
		color: #fff;
		font-variant-numeric: tabular-nums;
	}

	.proto-picker-divider {
		width: 1px;
		height: 16px;
		margin: 0 4px;
		background: rgba(255, 255, 255, 0.12);
	}

	.proto-picker-replay {
		padding: 0 10px;
		font-size: 14px;
	}

	.proto-picker[data-position='top'] {
		bottom: auto;
		top: 24px;
	}
</style>
